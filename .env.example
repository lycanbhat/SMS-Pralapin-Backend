# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=pralapin

# JWT (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=<your-secret-key-here>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Set to true for local development (disables secret validation)
DEBUG=true

# AWS S3
AWS_ACCESS_KEY_ID=<your-aws-access-key>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-key>
AWS_REGION=ap-south-1
S3_BUCKET_PHOTOS=pralapin-photos
S3_BUCKET_RECEIPTS=pralapin-receipts

# Firebase (path to service account JSON)
FIREBASE_CREDENTIALS_PATH=./pralapin-firebase-adminsdk.json

# Receipt (A5 PDF)
SCHOOL_NAME=Pralapin Montessori
SCHOOL_ADDRESS=
SCHOOL_LOGO_URL=
TRUST_LOGO_URL=
TRUST_ADDRESS=

# CCTV / HLS base URL
CCTV_BASE_URL=
SCHOOL_HOURS_START=08:00
SCHOOL_HOURS_END=18:00

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS_PRODUCTION=https://app.pralapin.com

# RBAC
ALLOW_EDIT_DEFAULT_ROLES=false

# API docs auth (Swagger/ReDoc/OpenAPI)
DOCS_AUTH_ENABLED=true
DOCS_AUTH_USERNAME=admin
DOCS_AUTH_PASSWORD=change-this-password
